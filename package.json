{
  "name": "@agenon/streamdeck-plugins",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --build --verbose",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "for d in plugins/*/*.sdPlugin; do streamdeck validate \"$d\" || exit 1; done"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "sharp": "^0.33.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
